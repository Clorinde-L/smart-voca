# 2026-10-28 - smart-voca - Git 추적 제외 목록
# 파일 위치: .gitignore

# 비밀정보 (CLAUDE.md 코드 작성 규칙 5)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# 사용자 데이터: 학습 기록, 불러온 단어장 사본 (데이터 설계서 DD-02)
userdata/

# 로그·백업·임시
logs/
backups/
*.log
*.tmp

# OS / 에디터
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code 로컬 설정
.claude/settings.local.json

# 외부 참고자료 원본 PDF (용량이 커서 커밋하지 않음, 경로만 문서에 남김)
ai-agent/uploads/*.pdf
